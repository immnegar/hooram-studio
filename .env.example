# ==============================================================
# HOORAM STUDIO — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================
# Copy this file to .env and configure values before starting the app.
# NEVER commit your real .env file with actual secrets to GitHub!

# Server Port (Default: 5000)
PORT=5000

# Environment Mode: 'development' or 'production'
NODE_ENV=production

# JWT Secret Key for Admin Authentication
# REQUIRED in production. Generate a strong 64-character secret, e.g. using:
# openssl rand -hex 32
JWT_SECRET=your_production_secure_jwt_secret_here

# Frontend API URL (if frontend is hosted on separate domain)
# VITE_API_BASE_URL=https://horamstudio.ir/api

# Test Credentials (Optional: used only when running local test scripts in scripts/)
# TEST_ADMIN_EMAIL=admin@example.com
# TEST_ADMIN_PASSWORD=your_test_password

# ==============================================================
# AUTOMATED DATABASE BACKUP CONFIGURATION (DATABASE ONLY)
# Note: Automated cloud backups protect ONLY the website database.
# Media files (portfolio images, videos) are served from web server storage.
# ==============================================================
# Active Cloud Storage Provider: 'google-drive' (default) | 's3' | 'local'
BACKUP_STORAGE_PROVIDER=google-drive

# 256-bit AES Encryption Key for encrypting backups before uploading to cloud
# REQUIRED for encrypted archives. Generate using: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=your_backup_encryption_key_here_32_bytes_hex

# Number of days to keep local and remote backup archives before GFS pruning
BACKUP_RETENTION_DAYS=7

# ==============================================================
# 1. GOOGLE DRIVE BACKUP CONFIGURATION (DEFAULT PROVIDER)
# ==============================================================
# Google Cloud Console OAuth 2.0 Client credentials:
# Create in Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application or Desktop)
GDRIVE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
GDRIVE_CLIENT_SECRET=your_google_oauth_client_secret_here

# Long-lived OAuth2 Refresh Token (used by headless cron on VPS without interactive login)
# Generated once using OAuth2 authorization flow with scope: https://www.googleapis.com/auth/drive.file
GDRIVE_REFRESH_TOKEN=your_google_oauth_refresh_token_here

# Optional: Specific Google Drive Folder ID to store backups in
# If left empty, the engine automatically creates and uses 'Horam-Studio-Backups'
# GDRIVE_FOLDER_ID=your_google_drive_folder_id_here
GDRIVE_ROOT_FOLDER_NAME=Horam-Studio-Backups

# ==============================================================
# 2. S3 / CLOUDFLARE R2 BACKUP CONFIGURATION (ALTERNATIVE)
# ==============================================================
# Used when BACKUP_STORAGE_PROVIDER=s3
# Your Cloudflare Account ID (found on the right sidebar of Cloudflare dashboard)
R2_ACCOUNT_ID=your_cloudflare_account_id_here

# R2 API Tokens (Access Key ID and Secret Access Key with Read & Write permissions)
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here

# The name of your R2 Bucket (e.g. hooram-studio-backups)
R2_BUCKET_NAME=hooram-studio-backups

# Custom S3 Endpoint (Optional: automatically computed from R2_ACCOUNT_ID if omitted)
# Format: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=https://your_cloudflare_account_id_here.r2.cloudflarestorage.com



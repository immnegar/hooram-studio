# ==============================================================
# HOORAM STUDIO — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================
# Copy this file to .env and configure values before starting the app.
# NEVER commit your real .env file with actual secrets to GitHub!

# Server Port (Default: 5000)
PORT=5000

# Environment Mode: 'development' or 'production'
NODE_ENV=production

# JWT Secret Key for Admin Authentication
# REQUIRED in production. Generate a strong 64-character secret, e.g. using:
# openssl rand -hex 32
JWT_SECRET=your_production_secure_jwt_secret_here

# Frontend API URL (if frontend is hosted on separate domain)
# VITE_API_BASE_URL=https://horamstudio.ir/api

# Test Credentials (Optional: used only when running local test scripts in scripts/)
# TEST_ADMIN_EMAIL=admin@example.com
# TEST_ADMIN_PASSWORD=your_test_password

